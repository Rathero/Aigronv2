# Copia este archivo a .env y ajusta los valores.

# --- Base de datos (coincide con docker-compose.yml) ---
DATABASE_URL=postgres://aigrons:aigrons@localhost:5432/aigrons

# --- Servidor ---
PORT=3000
# Orígenes permitidos para CORS (coma-separados). "*" en desarrollo.
CORS_ORIGIN=*
# Opcional: con varias instancias detrás del proxy, el rate limiting necesita un
# contador compartido. Si defines REDIS_URL se usa Redis; si no, memoria local.
# REDIS_URL=redis://localhost:6379
# Pon NODE_ENV=production al desplegar.
NODE_ENV=development

# --- Seguridad / Auth ---
# Secreto para firmar los JWT (OBLIGATORIO cambiar en producción).
JWT_SECRET=dev-secret-cambia-esto
# En producción pon false para EXIGIR tokens reales de Apple/Google.
ALLOW_DEV_AUTH=true
# IDs de cliente OAuth para verificar id_token (rellena al integrar el login móvil).
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_APPLE_CLIENT_ID=

# --- Lote diario ---
# Tamaño del lote (MVP: 30; producción objetivo: ~150-400).
DAILY_BATCH_SIZE=30

# --- Cron de generación nocturna en proceso ---
# Expresión cron (defecto 03:00 diario) y zona horaria. DISABLE_CRON=true lo apaga.
CRON_GENERATE=0 3 * * *
CRON_TZ=UTC
# DISABLE_CRON=false

# --- Pipeline de imagen IA (POR DEFECTO: gemini) ---
# El proveedor por defecto es GEMINI. Solo necesitas poner la API key gratis abajo.
# Saca la key gratis en https://aistudio.google.com/apikey (NO es la suscripción Premium).
GEMINI_API_KEY=AIza...
# AI_IMAGE_PROVIDER=gemini            # gemini (defecto) | procedural | openai
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # GRATIS (capa gratuita). De pago: gemini-3-pro-image
# GEMINI_ASPECT=1:1                   # relación de aspecto del arte
# AI_VISION_FILTER=off               # off (defecto) | on  (on = filtro de calidad/seguridad por visión)
# VISION_MODEL=gemini-2.5-flash      # modelo del filtro de visión (si AI_VISION_FILTER=on)
# ART_PUBLIC_BASE=/art               # base pública donde se sirve el arte generado
#
# -- Si no hay GEMINI_API_KEY, cae a 'procedural' (sprites, sin coste). --
# -- Opción OPENAI (de pago): AI_IMAGE_PROVIDER=openai + OPENAI_API_KEY + IMAGE_MODEL=gpt-image-1 --

# --- Compras (validación de recibos de tienda) ---
# true SOLO para demos/local: concede compras sin validar recibo.
ALLOW_STUB_PURCHASES=false

# --- Mecánicas innovadoras (flags) ---
# Todas activas por defecto. Pon =off para desactivar una; FEATURES_ALL=off las
# apaga todas (kill-switch). El cliente las pide en /features y oculta su UI.
# FEATURE_PUZZLE=off       # Puzzle Diario (combate-reto, mín. turnos)
# FEATURE_ECHOES=off       # Ecos en la Mazmorra (equipos caídos de otros)
# FEATURE_WORLDBOSS=off    # Jefe Mundial (raid cooperativa, HP global)
# FEATURE_NEMESIS=off      # Némesis (rival IA recurrente con counter-pick)
# FEATURE_PRISMATIC=off    # Variantes Prismáticas (1% cosmético)
# FEATURE_ORACLE=off       # El Oráculo (profecía del lote de mañana)
# FEATURE_ARENA=off        # Arena Sellada (draft del lote, sin colección)
# FEATURES_ALL=off         # apaga TODAS de golpe

# --- PvP en vivo ---
# Sin rival humano en este tiempo -> combate contra bot (0 = desactivar bots).
# PVP_BOT_WAIT_MS=8000
# Gracia de reconexión tras un corte de red antes de dar la partida por abandonada.
# PVP_RECONNECT_GRACE_MS=30000

# --- Higiene de datos (job diario de limpieza) y caché ---
# RETAIN_BATTLES_DAYS=30
# RETAIN_MISSIONS_DAYS=14
# RETAIN_SCORES_DAYS=90
# RANK_CACHE_MS=30000

# --- Pack de arte UI (opcional, scripts/gen-ui-assets.js) ---
# Con GEMINI_API_KEY puesto: `node scripts/gen-ui-assets.js --variants 3` genera
# icono, fondos (arena/jefe), plantilla de compartir y marcos a web/art/ui/.
# El juego funciona SIN estos assets (fallbacks: gradientes, emoji, color plano).
# El arte del JEFE semanal se genera solo (job de mantenimiento) si hay key.
